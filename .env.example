HARBORX_HOST=0.0.0.0
HARBORX_PORT=18080
HARBORX_DATA_DIR=/app/data
HARBORX_DB_PATH=/app/data/harborx.sqlite
HARBORX_WEB_DIST_DIR=/app/web-dist
# Required only on first run — sets the admin password for the bootstrap user
HARBORX_ADMIN_PASSWORD=change-me-before-deploy
# Comma-separated list of allowed origins. Leave empty for permissive (accepts any origin).
# Recommended in production: HARBORX_CORS_ORIGINS=https://your-domain.example.com
HARBORX_CORS_ORIGINS=

# ─── Agent (used when running the agent container) ───
HARBORX_AGENT_BASE_URL=https://your-harborx.example.com
HARBORX_AGENT_TOKEN=hxa_...
HARBORX_AGENT_INTERVAL_SECONDS=10
# Enable ONLY on servers you fully control. Shell-script tasks use a coarse
# allow-list guard but should still be treated as dangerous.
# HARBORX_AGENT_ALLOW_SHELL=1